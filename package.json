{
  "name": "storybook-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A component playground for exploring Storybook's features",
  "author": "Craig McNaughton",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:netlify": "tsc -b && vite build --outDir=netlify && vite build --base=/storybook-lab/ --outDir=netlify/storybook-lab",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint src e2e .storybook playwright.config.ts",
    "lint:fix": "eslint src e2e .storybook playwright.config.ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "prepare": "husky"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@eslint/js": "^9",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-mcp": "latest",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "^4",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "eslint-plugin-jsx-a11y": "^6",
    "eslint-plugin-react-hooks": "^7",
    "eslint-plugin-storybook": "^10.5.10",
    "happy-dom": "^20",
    "husky": "^9",
    "playwright": "latest",
    "prettier": "^3",
    "storybook": "^10.5.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^4",
    "vitest-axe": "1.0.0-pre.5"
  },
  "packageManager": "yarn@4.14.1"
}
